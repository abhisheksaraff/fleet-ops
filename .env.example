# .env.example - contains NO real credentials.
# Copy this file to .env and edit it locally:   cp .env.example .env
# .env is gitignored. Never commit a real key.

# AI backend: mock | gemini | ollama
# "mock" needs no key and no network, so everything runs offline.
LLM_PROVIDER=mock

# Required only when LLM_PROVIDER=gemini (create a key in Google AI Studio).
LLM_API_KEY=YOUR_LOCAL_API_KEY_HERE

# Optional model name. Leave blank to use the provider's default.
LLM_MODEL=

# Optional. Only used when LLM_PROVIDER=ollama.
LLM_BASE_URL=http://localhost:11434

# Where incidents are saved. A JDBC URL, or "memory" to keep them in memory only.
# The default is an embedded H2 file (no server or Docker needed).
DB_URL=jdbc:h2:./data/fleetops
# Only needed for databases other than the embedded H2 default.
DB_USER=sa
DB_PASSWORD=

# Where incident reports come from: any of  demo, google, telegram  (comma separated).
# "demo" is a few invented stories that work offline. "google" and "telegram" need internet.
NEWS_SOURCES=demo

# Public Telegram channel names (no @), used when NEWS_SOURCES includes telegram.
TELEGRAM_CHANNELS=

# Google News edition (language and country). The default is Canadian English.
NEWS_GOOGLE_EDITION=hl=en-CA&gl=CA&ceid=CA:en

# Disaster types to look for: any of  flood, famine, fire, earthquake  (blank = all four).
NEWS_TOPICS=

# Map tile source (OpenStreetMap needs no key).
MAP_TILES=osm
